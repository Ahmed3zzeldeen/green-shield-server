{
  "name": "green-shield-server",
  "version": "1.0.0",
  "description": "Green Shield Project Server is a backend application built with TypeScript, Express, and Prisma to provide RESTful APIs for the Green Shield Project.",
  "scripts": {
    "dev": "nodemon --config nodemon.json --exec ts-node --project tsconfig.node.json src/server.ts",
    "build": "prisma generate && tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "clean": "rm -rf dist dist-dev",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && tsc",
    "generate-ai-client": "orval"
  },
  "main": "dist/server.js",
  "keywords": [],
  "author": "Ahmed M. Ezzeldeen",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.946.0",
    "@aws-sdk/lib-storage": "^3.946.0",
    "@aws-sdk/s3-request-presigner": "^3.947.0",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.0.1",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-validator": "^7.3.0",
    "html-to-text": "^9.0.5",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.11",
    "pg": "^8.16.3",
    "pug": "^3.0.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/html-to-text": "^9.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.6",
    "@types/pug": "^2.0.10",
    "nodemon": "^3.1.10",
    "orval": "^7.17.0",
    "prisma": "^7.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
