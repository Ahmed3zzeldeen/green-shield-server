extends baseEmail

block content
  tr
    td.wrapper(style="font-family: Helvetica, sans-serif; font-size: 16px; vertical-align: top; box-sizing: border-box; padding: 24px;", valign="top")
      p Hi #{firstName},
      p We received a request to reset your password.
      
      p Your password reset code is:

      div(style="text-align: center; margin: 32px 0;")
        span(style="font-size: 36px; font-weight: bold; letter-spacing: 8px; color: #22c55e; background: #f0fdf4; padding: 16px 24px; border-radius: 12px; border: 2px dashed #22c55e; display: inline-block;")
          | #{otp}

      p This code will expire in <strong>10 minutes</strong>.
      p Enter this code in the app to set your new password.

      p If you didn't request this, you can safely ignore this email.

      p Thanks,
      p The Green Shield Team