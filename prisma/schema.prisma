// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========== Core Models ==========

enum Role {
  ADMIN
  FARMER
  GOVERNMENT
}

model User {
  id        String @id @default(uuid())
  firstName String
  lastName  String
  email     String @unique
  username  String @unique
  password  String
  role      Role   @default(FARMER)

  // Verification & metadata
  isEmailVerified Boolean @default(false)
  avatar          String? @default("/avatars/default.png")

  emailVerificationOtp     String?   @db.Text
  emailVerificationExpires DateTime?

  resetPasswordOtp     String?   @db.Text
  resetPasswordExpires DateTime? @db.Timestamptz

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  farms       Farm[]
  images      UploadedImage[]
  predictions Prediction[]
}

model Farm {
  id        String  @id @default(uuid())
  name      String
  address   String?
  state     String?
  city      String?
  longitude Float?
  latitude  Float?

  // Relation to User
  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SeverityLevel {
  LOW
  MEDIUM
  HIGH
}

model Disease {
  id            String        @id @default(uuid())
  nameEn        String        @unique
  nameAr        String        @unique
  descriptionEn String?
  descriptionAr String?
  severityLevel SeverityLevel @default(LOW)
  createdAt     DateTime      @default(now())

  treatments  Treatment[]
  predictions Prediction[]
}

model Treatment {
  id            String   @id @default(uuid())
  diseaseId     String
  disease       Disease  @relation(fields: [diseaseId], references: [id])
  titleEn       String
  titleAr       String
  descriptionEn String?
  descriptionAr String?
  isChemical    Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model UploadedImage {
  id         String   @id @default(uuid())
  key        String   @unique
  userId     String?
  url        String
  filename   String
  mimeType   String
  size       Int
  uploadedAt DateTime @default(now())

  user       User?       @relation(fields: [userId], references: [id])
  prediction Prediction?
}

model Prediction {
  id          String   @id @default(uuid())
  imageId     String   @unique
  userId      String?
  diseaseId   String
  confidence  Float
  severity    String?
  predictedAt DateTime @default(now())

  image   UploadedImage @relation(fields: [imageId], references: [id])
  user    User?         @relation(fields: [userId], references: [id])
  disease Disease       @relation(fields: [diseaseId], references: [id])
}
